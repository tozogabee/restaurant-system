# Copy to .env per service, or export these before running a service locally.
# The values match deploy/local/docker-compose.yml.
#
# Each service sets its own SERVICE_NAME, ports and POSTGRES_SCHEMA; everything
# else is shared across the local stack.

# --- Service identity -------------------------------------------------------
SERVICE_NAME=example
ENVIRONMENT=local
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

# Ports are per service. Leave one at 0 to disable that server.
# Convention: HTTP 81xx, gRPC 91xx (gateway 8080).
HTTP_PORT=8081
GRPC_PORT=9081

# --- Postgres ---------------------------------------------------------------
# One instance, one database, one schema per service. A service only ever
# touches its own schema.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
POSTGRES_DB=restaurant
POSTGRES_SCHEMA=example
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# --- Redis ------------------------------------------------------------------
# Shared instance. Keys are namespaced per service by redisx.NewNamespace.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Events ----------------------------------------------------------------
# No broker variables yet: Kafka vs NATS is still undecided, so pkg/ ships no
# broker client. Add them here together with that decision.
